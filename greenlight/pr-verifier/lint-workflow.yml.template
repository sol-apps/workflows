name: Greenlight

# This file is only a caller. pull_request_target makes GitHub load it from the
# reviewed base branch, and both jobs call verifier code pinned to one full public
# workflows commit. The audit job runs PR migrations but has no token permissions or secrets.
# The report job starts on a fresh runner, sees no PR files, and holds only checks:write.

on:
  pull_request_target:
    types: [opened, synchronize, reopened]

permissions: {}

concurrency:
  group: greenlight-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  audit:
    name: greenlight-audit
    permissions: {}
    runs-on: ubuntu-latest
    steps:
      - name: Audit the exact PR tree
        uses: sol-apps/workflows/greenlight/pr-verifier@{{ACTION_REF}}
        with:
          operation: audit
          repository: ${{ github.repository }}
          head-repository: ${{ github.event.pull_request.head.repo.full_name }}
          pull-request: ${{ github.event.pull_request.number }}
          base-sha: ${{ github.event.pull_request.base.sha }}
          head-sha: ${{ github.event.pull_request.head.sha }}
          template-ref: {{TEMPLATE_REF}}

  report:
    name: greenlight-report
    if: ${{ always() }}
    needs: audit
    permissions:
      checks: write
    runs-on: ubuntu-latest
    steps:
      - name: Publish the required check on the PR head
        uses: sol-apps/workflows/greenlight/pr-verifier@{{ACTION_REF}}
        with:
          operation: report
          repository: ${{ github.repository }}
          head-sha: ${{ github.event.pull_request.head.sha }}
          audit-result: ${{ needs.audit.result }}
          run-url: https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}
          token: ${{ github.token }}
